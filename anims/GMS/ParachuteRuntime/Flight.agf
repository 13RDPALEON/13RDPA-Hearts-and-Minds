AnimSrcGraphFile {
 Sheets {
  AnimSrcGraphSheet GMS_Flight {
   Nodes {
AnimSrcNodeVarSet MasterControl {
 Tags { "TagGMSParachutePrivate" }
 Child "GMS_FlightOrHold"
 VarSet { AnimSrcNodeVarSetFloatItem "{A97A1DFE4A1C1000}" {
      VariableName "GMSP_SL_HoldLeft" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), if(GetCommandIa(CMD_Gesture_NPC) == 103, GetCommandIc(CMD_Gesture_NPC)/100.0, 0), LastValue)"
    }
AnimSrcNodeVarSetFloatItem "{A97A1DFE4A1C1001}" {
      VariableName "GMSP_SL_HoldRight" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), if(GetCommandIa(CMD_Gesture_NPC) == 103, GetCommandId(CMD_Gesture_NPC)/100.0, 0), LastValue)"
    }
AnimSrcNodeVarSetBoolItem "{A97A1DFE4A1C1002}" {
      VariableName "GMSP_HALO_Enabled" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), GetCommandIa(CMD_Gesture_NPC) == 101, LastValue)"
    }
AnimSrcNodeVarSetBoolItem "{A97A1DFE4A1C1003}" {
      VariableName "GMSP_SL_ObserverRoot" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), false, LastValue)"
    }
AnimSrcNodeVarSetBoolItem "{A97A1DFE4A1C1004}" {
      VariableName "GMSP_SL_Enabled" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), GetCommandIa(CMD_Gesture_NPC) == 102, LastValue)"
    }
AnimSrcNodeVarSetFloatItem "{A97A1DFE4A1C1005}" {
      VariableName "GMSP_SL_RecoveryOffsetX" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), if(GetCommandIa(CMD_Gesture_NPC) == 102 && GetCommandIb(CMD_Gesture_NPC) >= 96, GetCommandF(CMD_Gesture_NPC), 0), LastValue)"
    }
AnimSrcNodeVarSetFloatItem "{A97A1DFE4A1C1006}" {
      VariableName "GMSP_SL_RecoveryOffsetZ" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), if(GetCommandIa(CMD_Gesture_NPC) == 102 && GetCommandIb(CMD_Gesture_NPC) >= 96, (GetCommandId(CMD_Gesture_NPC)*256 + if(GetCommandIc(CMD_Gesture_NPC) < 0, GetCommandIc(CMD_Gesture_NPC)+256, GetCommandIc(CMD_Gesture_NPC)))/1000.0, 0), LastValue)"
    }
AnimSrcNodeVarSetIntItem "{A97A1DFE4A1C1007}" {
      VariableName "GMSP_SL_Phase" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), if(GetCommandIb(CMD_Gesture_NPC) >= 96, 3, if(GetCommandIb(CMD_Gesture_NPC) >= 64, 2, if(GetCommandIb(CMD_Gesture_NPC) >= 32, 1, 0))), LastValue)"
    }
AnimSrcNodeVarSetBoolItem "{A97A1DFE4A1C1008}" {
      VariableName "GMSP_FF_Active" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), inRange(GetCommandIa(CMD_Gesture_NPC), 101, 102), LastValue)"
    }
AnimSrcNodeVarSetIntItem "{A97A1DFE4A1C1009}" {
      VariableName "GMSP_FF_Dir" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), GetCommandIb(CMD_Gesture_NPC) - 32*(if(GetCommandIb(CMD_Gesture_NPC) >= 96, 3, if(GetCommandIb(CMD_Gesture_NPC) >= 64, 2, if(GetCommandIb(CMD_Gesture_NPC) >= 32, 1, 0)))), LastValue)"
    }
AnimSrcNodeVarSetFloatItem "{A97A1DFE4A1C100A}" {
      VariableName "GMSP_FF_DirX" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), if(GetCommandIa(CMD_Gesture_NPC) == 102 && GetCommandIb(CMD_Gesture_NPC) >= 96, 0, GetCommandIc(CMD_Gesture_NPC)/100.0), LastValue)"
    }
AnimSrcNodeVarSetFloatItem "{A97A1DFE4A1C100B}" {
      VariableName "GMSP_FF_DirY" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), if(GetCommandIa(CMD_Gesture_NPC) == 102 && GetCommandIb(CMD_Gesture_NPC) >= 96, 0, GetCommandId(CMD_Gesture_NPC)/100.0), LastValue)"
    }
AnimSrcNodeVarSetBoolItem "{A97A1DFE4A1C100C}" {
      VariableName "GMSP_HoldActive" SetOnInit 1 SetOnMainPath 1 SetOnBlendOut 1 PostEval 1 Value "if(inRange(GetCommandIa(CMD_Gesture_NPC), 101, 103), GetCommandIa(CMD_Gesture_NPC) == 103, LastValue)"
    } }
}
