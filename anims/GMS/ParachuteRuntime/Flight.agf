AnimSrcNodeBlend GMS_FlightOrHold {
 BlendWeight "if(GMSP_HoldActive, 1, 0)"
 Child0 "GMS_ParachuteMode" Child1 "GMS_HoldRight"
 Optimization "Skip blended out"
}
AnimSrcNodeBufferUse GMS_HoldBase { BufferName "FullBodyNPC" }
AnimSrcNodePose GMS_HoldLeftPose { Source "ZZ_GMSFF.Default.Steer_L" Time "0" }
AnimSrcNodePose GMS_HoldRightPose { Source "ZZ_GMSFF.Default.Steer_R" Time "0" }
AnimSrcNodeBlend GMS_HoldLeft {
 Child0 "GMS_HoldBase" Child1 "GMS_HoldLeftPose"
 BlendWeight "GMSP_SL_HoldLeft" Optimization "Always eval both"
}
AnimSrcNodeBlend GMS_HoldRight {
 Child0 "GMS_HoldLeft" Child1 "GMS_HoldRightPose"
 BlendWeight "GMSP_SL_HoldRight" Optimization "Always eval both"
}

AnimSrcNodeStateMachine GMS_ParachuteMode {
     EditorPos -100 -20
     states {
      AnimSrcNodeState NoRig {
       Child "GMSFF_SrcNeutral"
       StartCondition "!GMSP_SL_Enabled && !GMSP_HALO_Enabled"
      }
      AnimSrcNodeState HALO {
       EditorPos -104 -17
       Child "GMSFF_Compass"
       StartCondition "GMSP_HALO_Enabled && !GMSP_SL_Enabled"
      }
      AnimSrcNodeState StaticLine {
       EditorPos -96 -17
       Child "GMS_SL_StaticLine"
       StartCondition "GMSP_SL_Enabled"
      }
     }
     transitions {
      AnimSrcNodeTransition SL_Select {
       FromState ""
       ToState "StaticLine"
       Duration "0.1"
       Condition "GMSP_SL_Enabled"
       Reentering Forbidden
      }
      AnimSrcNodeTransition HALO_Select {
       FromState ""
       ToState "HALO"
       Duration "0.1"
       Condition "GMSP_HALO_Enabled && !GMSP_SL_Enabled"
       Reentering Forbidden
      }
      AnimSrcNodeTransition NoRig_Select {
       FromState ""
       ToState "NoRig"
       Duration "0.1"
       Condition "!GMSP_SL_Enabled && !GMSP_HALO_Enabled"
       Reentering Forbidden
      }
     }
    }
AnimSrcNodeStateMachine GMS_SL_StaticLine {
     Tags {
      "TagGMSFF"
      "TagGMSSLBranch"
     }
     EditorPos -100 25
     states {
      AnimSrcNodeState SL_Fall {
       EditorPos -108 30
       Child "GMS_SL_FallSourceLandingFrame"
       StartCondition "GMSP_SL_Phase == 0"
       TimeStorage "Real Time"
      }
      AnimSrcNodeState SL_Exit {
       EditorPos -100 30
       Child "GMS_SL_ExitSourceLandingFrame"
       StartCondition "GMSP_SL_Phase == 1"
       TimeStorage "Real Time"
      }
      AnimSrcNodeState SL_Hang {
       EditorPos -92 30
       Child "GMS_SL_HangPoseLandingFrame"
       StartCondition "GMSP_SL_Phase == 2"
       TimeStorage "Real Time"
      }
      AnimSrcNodeState SL_Land {
       EditorPos -84 40
       Child "GMS_SL_LandingSound"
       StartCondition "GMSP_SL_Phase == 3"
       TimeStorage "Real Time"
      }
      AnimSrcNodeState SL_Roll {
       EditorPos -84 41
       Child "GMS_SL_RollSourceAligned"
       StartCondition "false"
       TimeStorage "Real Time"
      }
      AnimSrcNodeState SL_Recover {
       EditorPos -84 43
       Child "GMS_SL_RecoverSourceAligned"
       StartCondition "false"
       TimeStorage "Real Time"
      }
      AnimSrcNodeState SL_Done {
       EditorPos -84 44
       Child "GMS_SL_CrouchPoseAligned"
       StartCondition "false"
       TimeStorage "Real Time"
      }
     }
     transitions {
      AnimSrcNodeTransition SL_TouchdownHang {
       FromState "SL_Hang"
       ToState "SL_Land"
       Duration ".2"
       Condition "GMSP_SL_Phase == 3"
       BlendFn "S"
       PostEval 1
      }
      AnimSrcNodeTransition SL_TouchdownExit {
       FromState "SL_Exit"
       ToState "SL_Land"
       Duration ".2"
       Condition "GMSP_SL_Phase == 3"
       BlendFn "S"
       PostEval 1
      }
      AnimSrcNodeTransition SL_RollOver {
       FromState "SL_Land"
       ToState "SL_Roll"
       Duration ".3"
       Condition "RemainingTimeLess(3.133333)"
       BlendFn "S"
       PostEval 1
      }
      AnimSrcNodeTransition SL_GetUp {
       FromState "SL_Roll"
       ToState "SL_Recover"
       Duration ".25"
       Condition "RemainingTimeLess(0.25)"
       BlendFn "S"
       PostEval 1
      }
      AnimSrcNodeTransition SL_Recovered {
       FromState "SL_Recover"
       ToState "SL_Done"
       Duration ".1"
       Condition "RemainingTimeLess(0.1)"
       BlendFn "S"
       PostEval 1
      }
      AnimSrcNodeTransition SL_Deploy {
       FromState "SL_Fall"
       ToState "SL_Exit"
       Duration "0.05"
       Condition "GMSP_SL_Phase == 1"
      }
      AnimSrcNodeTransition SL_Opened {
       FromState "SL_Exit"
       ToState "SL_Hang"
       Duration "0.1"
       Condition "GMSP_SL_Phase == 2"
      }
      AnimSrcNodeTransition SL_Reset {
       FromState ""
       ToState "SL_Fall"
       Duration "0.1"
       Condition "GMSP_SL_Phase == 0"
       Reentering Forbidden
      }
     }
    }
AnimSrcNodeSource GMS_SL_FallSource {
     EditorPos -108 34
     Source "ZZ_GMSSL.Default.Fall"
     Looptype "Loop"
    }
AnimSrcNodeSource GMS_SL_ExitSource {
     EditorPos -100 34
     Source "ZZ_GMSSL.Default.Exit"
     Looptype "No Loop"
    }
AnimSrcNodePose GMS_SL_HangPose {
     EditorPos -92 34
     Source "ZZ_GMSSL.Default.Hang"
     Time "1.0"
    }
AnimSrcNodeProcTransform GMS_SL_FallSourceLandingFrame {
     Child "GMS_SL_FallSource"
     Expression "if(GMSP_SL_Phase == 3, rad(90), 0)"
     Bones {
      AnimSrcNodeProcTrBoneItem SL_AirRoot {
       Operation "Rotate Around"
       Axis X
       Amount "1"
       Space Model
       PivotBone "Scene_Root"
       Bone "EntityPosition"
      }
     }
    }
AnimSrcNodeProcTransform GMS_SL_ExitSourceLandingFrame {
     Child "GMS_SL_ExitSource"
     Expression "if(GMSP_SL_Phase == 3, rad(90), 0)"
     Bones {
      AnimSrcNodeProcTrBoneItem SL_AirRoot {
       Operation "Rotate Around"
       Axis X
       Amount "1"
       Space Model
       PivotBone "Scene_Root"
       Bone "EntityPosition"
      }
     }
    }
AnimSrcNodeProcTransform GMS_SL_HangPoseLandingFrame {
     Child "GMS_SL_HangPose"
     Expression "if(GMSP_SL_Phase == 3, rad(90), 0)"
     Bones {
      AnimSrcNodeProcTrBoneItem SL_AirRoot {
       Operation "Rotate Around"
       Axis X
       Amount "1"
       Space Model
       PivotBone "Scene_Root"
       Bone "EntityPosition"
      }
     }
    }
AnimSrcNodeProcTransform GMS_SL_RollSourceAligned {
     Child "GMS_SL_RollSource"
     Expression "1"
     Bones {
      AnimSrcNodeProcTrBoneItem SL_RecoveryX {
       Operation Translate
       Axis X
       Amount "GMSP_SL_RecoveryOffsetX"
       Space Model
       Bone "Hips"
      }
      AnimSrcNodeProcTrBoneItem SL_RecoveryZ {
       Operation Translate
       Axis Z
       Amount "GMSP_SL_RecoveryOffsetZ"
       Space Model
       Bone "Hips"
      }
     }
    }
AnimSrcNodeProcTransform GMS_SL_RecoverSourceAligned {
     Child "GMS_SL_RecoverSource"
     Expression "1"
     Bones {
      AnimSrcNodeProcTrBoneItem SL_RecoveryX {
       Operation Translate
       Axis X
       Amount "GMSP_SL_RecoveryOffsetX"
       Space Model
       Bone "Hips"
      }
      AnimSrcNodeProcTrBoneItem SL_RecoveryZ {
       Operation Translate
       Axis Z
       Amount "GMSP_SL_RecoveryOffsetZ"
       Space Model
       Bone "Hips"
      }
     }
    }
AnimSrcNodeProcTransform GMS_SL_CrouchPoseAligned {
     Child "GMS_SL_CrouchPose"
     Expression "1"
     Bones {
      AnimSrcNodeProcTrBoneItem SL_RecoveryX {
       Operation Translate
       Axis X
       Amount "GMSP_SL_RecoveryOffsetX"
       Space Model
       Bone "Hips"
      }
      AnimSrcNodeProcTrBoneItem SL_RecoveryZ {
       Operation Translate
       Axis Z
       Amount "GMSP_SL_RecoveryOffsetZ"
       Space Model
       Bone "Hips"
      }
     }
    }
